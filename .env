# AgentX Environment Configurations

# Server Settings
PORT=8000
HOST=0.0.0.0
NODE_PORT=3000

# Database Settings
DB_USER=agentx_admin
DB_PASSWORD=agentx_secret_pass
DB_NAME=agentx_db
DB_HOST=localhost
DB_PORT=5432
# Default to SQLite for easy local development. Swap this with PostgreSQL in production.
DATABASE_URL=sqlite+aiosqlite:///./agentx.db

# Redis Broker & Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security Settings
JWT_SECRET=super_secret_jwt_key_agent_x_ecosystem_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Provider Configurations (Fill in your keys)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Tavily API Key for Web Search
TAVILY_API_KEY=your-tavily-api-key-here

# Observability Settings
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_MULTIPROC_DIR=/tmp
