# ==============================================================================
# AgentX AI Operating System — Safe Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and provide your actual API keys.
# NEVER commit your live '.env' file containing real secrets to version control.
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///agentx.db

# LLM Provider Configuration
# Supported providers: google, openai, anthropic, ollama, mock
DEFAULT_LLM_PROVIDER=auto

# Google Gemini (Recommended)
GOOGLE_API_KEY=your-gemini-api-key-here
DEFAULT_GOOGLE_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Local Ollama (Free & Local)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3

# Optional: Offline Mock Mode (For automated CI unit testing only)
AGENTX_ALLOW_MOCK=false

# Search & Research Tools
TAVILY_API_KEY=your-tavily-api-key-here

# Authentication & Security
JWT_SECRET_KEY=agentx-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
